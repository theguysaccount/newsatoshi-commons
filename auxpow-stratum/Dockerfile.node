# Verified upstream Newsatoshi v0.1.0 L1 full node (SHA-256 pinned)
FROM rust:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN curl -fsSL https://newsatoshi.org/newsatoshi-0.1.0-src.zip -o newsatoshi-0.1.0-src.zip \
    && echo "3d022302f4120a446dc2cc505dcf51036d832e1d68d3855c0afc38aacb396134  newsatoshi-0.1.0-src.zip" | sha256sum -c - \
    && unzip -q newsatoshi-0.1.0-src.zip \
    && cd newsatoshi-0.1.0/node \
    && cargo build --release --locked

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/newsatoshi-0.1.0/node/target/release/newsatoshi /usr/local/bin/newsatoshi

VOLUME ["/data"]
EXPOSE 8444 18444 19556 8080

ENTRYPOINT ["/usr/local/bin/newsatoshi"]
