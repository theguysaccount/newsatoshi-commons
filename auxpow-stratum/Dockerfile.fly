# Single-container public Newsatoshi Mainnet v2 (nsM2, v1.2.0) AuxPoW Solo-Mining Pool + IPv4 P2P Seed (Fly.io)
# Runs canonical v1.2.0 Mainnet v2 node + zero-fee per-miner direct-payout Stratum v1 server.

FROM rust:bookworm AS node-builder

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
ARG NS_REF=v1.2.0
RUN git clone --depth 1 --branch "${NS_REF}" https://github.com/theguysaccount/newsatoshi-rfc0021.git . \
    && cd node \
    && cargo build --release --bin newsatoshi

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates python3 openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=node-builder /src/node/target/release/newsatoshi /usr/local/bin/newsatoshi
COPY stratum_auxpow.py /app/stratum_auxpow.py
COPY entrypoint-fly.sh /app/entrypoint-fly.sh
RUN chmod +x /app/entrypoint-fly.sh /usr/local/bin/newsatoshi

VOLUME ["/data"]
EXPOSE 3333 8080 8445

ENTRYPOINT ["/app/entrypoint-fly.sh"]
