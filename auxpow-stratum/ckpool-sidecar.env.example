# CKPool / Public Pool / Solo bitcoind Sidecar Environment Template
# Copy to .env and run: docker compose -f docker-compose.merge-mine.yml up -d
#
# Standard Namecoin 0xfabe6d6d AuxPoW merge-mining (chainid = 20051)
# Zero disruption to Bitcoin block templates; 50 LOVE/block earned at $0 extra power.

# Your existing Bitcoin Core node (same host or LAN IP)
BTC_RPC_URL=http://host.docker.internal:8332/
BTC_RPC_AUTH=bitcoinrpc:REPLACE_WITH_BITCOIND_RPC_PASSWORD
# Hex scriptPubKey where BTC solo blocks pay (e.g., P2WPKH: 0014<20-byte-hash160>)
BTC_PAYOUT_SCRIPT_HEX=0014REPLACE_WITH_YOUR_20_BYTE_WITNESS_PROGRAM

# Your 74-character Newsatoshi Mainnet v2 (nsM2) shielded payout address
# Generate via: ./newsatoshi --net mainnet-v2 address
NS_PAYOUT_ADDRESS=ns1REPLACE_WITH_YOUR_74_CHAR_MAINNET_V2_ADDRESS

# Strong internal RPC secret between local newsatoshi-v2-node and stratum bridge
NS_RPC_AUTH=auxpow:REPLACE_WITH_32_HEX_RANDOM_SECRET

# Stratum & status bind ports
STRATUM_PORT=3333
STATUS_PORT=3334
COINBASE_TAG=/yourpool-btc+love/
POLL_INTERVAL=1.5
